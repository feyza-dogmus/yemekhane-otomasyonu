<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof baslik !== 'undefined' ? baslik + ' · ' : '' %>Yemekhane Otomasyonu</title>
  <link rel="stylesheet" href="/css/temel.css">
  <link rel="stylesheet" href="/css/uygulama.css">
</head>
<body>
<header class="ustbar">
  <div class="kapsayici">
    <a class="marka" href="/">Yemekhane</a>
    <% if (kullanici) { %>
      <nav>
        <a href="/menu">Günün Menüsü</a>
        <a href="/haftalik">Haftalık Menü</a>
        <a href="/rezervasyonlarim">Rezervasyonlarım</a>
        <a href="/bakiye">Bakiye</a>
        <a href="/degerlendirme">Değerlendirme</a>
        <% if (kullanici.rol === 'yonetici') { %><a href="/yonetim">Yönetim</a><% } %>
      </nav>
      <form method="post" action="/cikis">
        <span class="kullanici-ad"><%= kullanici.ad %> <%= kullanici.soyad %></span>
        <button class="dugme dugme-ikincil" type="submit">Çıkış</button>
      </form>
    <% } %>
  </div>
</header>
<% if (bildirim) { %>
  <div class="kapsayici mesaj-alani">
    <p class="bildirim bildirim-<%= bildirim.tur %>" role="<%= bildirim.tur === 'hata' ? 'alert' : 'status' %>"><%= bildirim.metin %></p>
  </div>
<% } %>